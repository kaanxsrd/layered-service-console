<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <RootNamespace>Project</RootNamespace>
        <!-- Allow running on a newer installed runtime when net8.0 isn't present. -->
        <RollForward>LatestMajor</RollForward>
        <AssemblyName>Project</AssemblyName>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!--
            Suppressions, with rationale:
              CA1000   - static factories on Result<T> are the established pattern.
              CA1031   - top-level catch in Program.cs and file I/O are intentional.
              CA1062   - internal-only callers; repeated null checks are noise.
              CA1303   - localization: console strings are not resourced here.
              CA1716   - `Error` type name is allowed by convention in Result pipelines.
              CA1812   - DI-instantiated types appear uninstantiated to the analyzer.
              CA1822   - interface methods can't be static; helpers intentionally instance-based.
              CA1848/CA1873 - LoggerMessage source generators not worth the ceremony here.
              CA2007   - console app; no SynchronizationContext, ConfigureAwait optional.
              IDE0028/0290/0300/0305 - style preferences (collection exprs / primary ctors).
        -->
        <NoWarn>$(NoWarn);CA1000;CA1031;CA1062;CA1303;CA1716;CA1812;CA1822;CA1848;CA1873;CA2007;IDE0028;IDE0290;IDE0300;IDE0305</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Infrastructure/Persistence/*.todo" />
      <None Include="Infrastructure/Persistence/*.todo" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    </ItemGroup>

</Project>
