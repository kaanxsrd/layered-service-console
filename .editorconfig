root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# File-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning

# Prefer var when the type is obvious
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Sort using directives; System first
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Don't enforce primary constructors on us (we prefer explicit ctors for readability)
dotnet_diagnostic.IDE0290.severity = none

# Silence "collection initialization can be simplified" — keep explicit in some cases
dotnet_diagnostic.IDE0028.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0305.severity = none

[*.{csproj,slnx,props,targets}]
indent_style = space
indent_size = 2
